# SlyxUp Stack — CF Workers + D1 — Domains: slyxup.online/stack/*
# Copy to auth.slyxup.online/.dev.vars for local dev (wrangler dev)

# === DOMAINS (Prod) ===
APP_URL=https://stack.slyxup.online
API_URL=https://auth.slyxup.online
BILLING_URL=https://billing.slyxup.online
HOSTED_AUTH_URL=https://auth.slyxup.online

# Local overrides (use in .dev.vars, NOT wrangler.jsonc)
# APP_URL=http://localhost:3000
# API_URL=http://localhost:8787
# HOSTED_AUTH_URL=http://localhost:8787

# === D1 (set via wrangler d1 create, already wired) ===
# slyxup_auth: cfa91e79-cf3d-483f-94a0-0a9dc33cb31a
# slyxup_billing: 5c5a0f61-3ca8-4e12-baf2-29e2d2ce9415

# === BREVO Email (Sender noreply@slyxup.online) ===
# Local: .dev.vars BREVO_API_KEY + BRAVO_API_KEY (same) — get from https://app.brevo.com/settings/keys/api
# Prod: wrangler secret put BREVO_API_KEY --config auth.slyxup.online/wrangler.jsonc
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
BRAVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
EMAIL_FROM=noreply@slyxup.online
EMAIL_FROM_NAME=SlyxUp

# === OAuth — Dev vs Prod (2 apps each, GitHub needs 2) ===
# DEV (localhost): use in auth.slyxup.online/.dev.vars — create at console.cloud.google.com / github.com/settings/developers
# GOOGLE_CLIENT_ID=REPLACE_WITH_DEV_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=REPLACE_WITH_DEV_GOOGLE_CLIENT_SECRET
# GITHUB_CLIENT_ID=REPLACE_WITH_DEV_GITHUB_CLIENT_ID
# GITHUB_CLIENT_SECRET=REPLACE_WITH_DEV_GITHUB_CLIENT_SECRET
# Callback: http://localhost:8787/v1/oauth/callback/{google,github} , http://localhost:8787/sso-callback

# PROD (auth.slyxup.online): use in wrangler.jsonc vars + wrangler secret put
# GOOGLE_CLIENT_ID=REPLACE_WITH_PROD_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=REPLACE_WITH_PROD_GOOGLE_CLIENT_SECRET
# GITHUB_CLIENT_ID=REPLACE_WITH_PROD_GITHUB_CLIENT_ID
# GITHUB_CLIENT_SECRET=REPLACE_WITH_PROD_GITHUB_CLIENT_SECRET
# Callback: https://auth.slyxup.online/v1/oauth/callback/{google,github} , https://auth.slyxup.online/sso-callback

# === CORS / Redirect (Prod vars in wrangler.jsonc, local via .dev.vars localhost) ===
CORS_ORIGINS=https://stack.slyxup.online,http://localhost:3000,http://localhost:8787
ALLOWED_REDIRECT_ORIGINS=https://myapp.com,http://localhost:3000,http://localhost:8787,https://auth.slyxup.online

# === BILLING Worker (billing.slyxup.online) — see billing.slyxup.online/.env.example ===
# Local: cp billing.slyxup.online/.dev.vars.example billing.slyxup.online/.dev.vars (port 8788)
# Prod secrets: wrangler secret put PADDLE_API_KEY|PADDLE_WEBHOOK_SECRET|BILLING_ADMIN_SECRET --config billing.slyxup.online/wrangler.jsonc

# === Single-Tenant / Bootstrap (personal instance: only YOU are admin, others self-host) ===
# This makes your live stack at stack.slyxup.online private (docs/sdk stay public, dashboard is owner-only).
# Self-hosters run their own auth Worker — see https://stack.slyxup.online/docs/self-host
SINGLE_TENANT_MODE=true
ALLOW_PUBLIC_DEVELOPER_REGISTRATION=false
# Lock first admin to your email (recommended). Only this email can claim the first admin.
# Leave empty to allow any email on first bootstrap, but combine with BOOTSTRAP_SECRET for safety.
BOOTSTRAP_ADMIN_EMAIL=
# Secret token required to claim the first admin (use `openssl rand -hex 32` and store as wrangler secret).
# For local dev you can leave empty; for prod single-tenant you SHOULD set it:
#   wrangler secret put BOOTSTRAP_SECRET --config auth.slyxup.online/wrangler.jsonc
# Then bootstrap via:  curl -X POST https://auth.slyxup.online/v1/setup/bootstrap \
#   -H 'Content-Type: application/json' -H 'X-Bootstrap-Token: $BOOTSTRAP_SECRET' \
#   -d '{"email":"you@example.com","password":"StrongPass123", "name":"Owner"}'
# Or use CLI:  npx @slyxup/cli bootstrap --email you@example.com --password StrongPass123 --token $BOOTSTRAP_SECRET
BOOTSTRAP_SECRET=

# === Secrets (ALWAYS wrangler secret put, NEVER commit) ===
# SESSION_SECRET, ENCRYPTION_KEY, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_SECRET, BREVO_API_KEY, SMTP_PASSWORD, BOOTSTRAP_SECRET
