# SlyxUp Stack — CF Workers + D1
# Copy to .dev.vars for Wrangler local dev (auth.slyxup.online/.dev.vars)

# Domains
APP_URL=https://stack.slyxup.online
API_URL=https://auth.slyxup.online
BILLING_URL=https://billing.slyxup.online

# D1 (set via wrangler d1 create)
# D1_DATABASE_ID=xxxx

# Secrets (use wrangler secret put, NOT .env)
# SESSION_SECRET, ENCRYPTION_KEY, GOOGLE_CLIENT_SECRET etc. -> wrangler secret put

# OAuth (public IDs can be vars, secrets must be wrangler secret put)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=

# For Pages/Workers local
CORS_ORIGINS=https://stack.slyxup.online,http://localhost:3000
ALLOWED_REDIRECT_ORIGINS=https://myapp.com,http://localhost:3000
