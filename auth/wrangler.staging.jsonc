{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Staging Auth Worker (Week 7). Create resources once, then fill in IDs:
  //   wrangler d1 create slyxup-auth-staging
  //   wrangler kv:namespace create slyxup-cache-staging
  // Deploy: pnpm --filter auth exec wrangler deploy --config wrangler.staging.jsonc
  // NOTE: database_id / kv id below are placeholders — replace with real values.
  "name": "auth-slyxup-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_URL": "https://staging.slyxup.com",
    "API_URL": "https://auth-staging.slyxup.com",
    "HOSTED_AUTH_URL": "https://auth-staging.slyxup.com",
    "CORS_ORIGINS": "https://staging.slyxup.com,http://localhost:3000,http://localhost:5173,http://localhost:8787",
    "ALLOWED_REDIRECT_ORIGINS": "https://staging.slyxup.com,http://localhost:3000,http://localhost:5173,http://localhost:8787",
    "EMAIL_FROM": "noreply@slyxup.com",
    "EMAIL_FROM_NAME": "SlyxUp (staging)",
    "SINGLE_TENANT_MODE": "true",
    "ALLOW_PUBLIC_DEVELOPER_REGISTRATION": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "slyxup_auth_staging",
    "database_id": "REPLACE_WITH_STAGING_AUTH_D1_ID",
    "migrations_dir": "migrations"
  }],
  "kv_namespaces": [{
    "binding": "KV",
    "id": "REPLACE_WITH_STAGING_KV_ID"
  }]
}
