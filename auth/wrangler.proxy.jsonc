{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "ed01399ae5f7a46697e0802e4eaef6a9",
  "name": "auth-slyxup-com-proxy",
  "main": "proxy.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "AUTH_ORIGIN": "https://auth-slyxup-com.auth-0f4.workers.dev"
  },
  "routes": [{
    "pattern": "auth.slyxup.com",
    "custom_domain": true
  }]
}
