{
  "name": "auth",
  "private": true,
  "version": "0.1.1",
  "description": "SlyxUp Auth Worker — Hono + D1 + KV (https://auth.slyxup.online) — CF Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply slyxup_auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply slyxup_auth --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.5.0",
    "wrangler": "^4.130.0"
  }
}
