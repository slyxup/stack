{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0f4dbe798770fbb21623ac2b9cc61450",
  "name": "auth-slyxup-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_URL": "https://email.slyxup.com",
    "API_URL": "https://auth-slyxup-com.auth-0f4.workers.dev",
    "HOSTED_AUTH_URL": "https://auth-slyxup-com.auth-0f4.workers.dev",
    "CORS_ORIGINS": "https://email.slyxup.com,http://localhost:3000,http://localhost:5173,http://localhost:8787",
    "ALLOWED_REDIRECT_ORIGINS": "https://email.slyxup.com,http://localhost:3000,http://localhost:5173,http://localhost:8787",
    "GOOGLE_CLIENT_ID": "733897164108-o1reljhjoi3oho61hcksv5lv693u09ji.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23liAPqCFTwbp2umVu",
    "EMAIL_FROM": "noreply@slyxup.com",
    "EMAIL_FROM_NAME": "SlyxUp",
    "BREVO_SENDER": "noreply@slyxup.com",
    "SINGLE_TENANT_MODE": "true",
    "ALLOW_PUBLIC_DEVELOPER_REGISTRATION": "false",
    "BOOTSTRAP_ADMIN_EMAIL": "slyxup@gmail.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "slyxup_auth_com",
    "database_id": "a53ddd83-17bf-4d12-97cb-9b8ff1ddc284",
    "migrations_dir": "migrations"
  }],
  "kv_namespaces": [{
    "binding": "KV",
    "id": "d6ae40912be54800b9600e62f1087471"
  }]
}
