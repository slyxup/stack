{
  "name": "@slyxup/nextjs",
  "version": "1.0.5",
  "description": "@slyxup/nextjs — SlyxUp SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    },
    "./server": {
      "import": "./dist/server/auth.js",
      "types": "./dist/server/auth.d.ts"
    },
    "./cookies": {
      "import": "./dist/cookies.js",
      "types": "./dist/cookies.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slyxup/stack.git",
    "directory": "packages/nextjs"
  },
  "homepage": "https://github.com/slyxup/stack/tree/main/packages/nextjs#readme",
  "bugs": {
    "url": "https://github.com/slyxup/stack/issues"
  },
  "author": "SlyxUp <hello@slyxup.online>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": "^14 || ^15"
  },
  "dependencies": {
    "@slyxup/core": "^1.2.0"
  },
  "devDependencies": {
    "next": "^15.0.0",
    "vitest": "^4.1.11"
  }
}
