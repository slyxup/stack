{
  "name": "billing",
  "private": true, "version": "0.1.0",
  "description": "SlyxUp Billing Worker — Hono + D1 + Paddle — Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy --config wrangler.com-workers-dev.jsonc",
    "typegen": "wrangler types --config wrangler.com-workers-dev.jsonc",
    "paddle:live": "bash scripts/configure-paddle-live.sh",
    "paddle:live:map-price": "bash scripts/map-paddle-live-price.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply slyxup_billing_com --local --config wrangler.com-workers-dev.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply slyxup_billing_com --remote --config wrangler.com-workers-dev.jsonc"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.5.0",
    "wrangler": "^4.130.0"
  }
}
