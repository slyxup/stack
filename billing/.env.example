# SlyxUp Billing Worker — billing.slyxup.com — CF Workers + D1 + Paddle
# Copy this file to billing.slyxup.com/.dev.vars for local dev (wrangler dev).
# NEVER commit .dev.vars or real secrets — only wrangler secret put for prod.

# === DOMAINS ===
# Local dev (.dev.vars): APP_URL=http://localhost:3000 AUTH_URL=http://localhost:8787 API_URL=http://localhost:8788
APP_URL=https://stack.slyxup.com
AUTH_URL=https://auth-slyxup-com.auth-0f4.workers.dev
API_URL=https://billing-slyxup-com.billing-86c.workers.dev

# === CORS (comma-separated origins allowed to call the billing API with cookies) ===
# Local dev (.dev.vars): CORS_ORIGINS=http://localhost:3000,http://localhost:8787
CORS_ORIGINS=https://stack.slyxup.com,https://email.slyxup.com

# === D1 / KV bindings (already wired in wrangler.jsonc) ===
# slyxup_billing DB: 5c5a0f61-3ca8-4e12-baf2-29e2d2ce9415  -> binding DB
# slyxup_auth   DB: cfa91e79-cf3d-483f-94a0-0a9dc33cb31a   -> binding AUTH_DB (session validation)
# KV id            : 74a592aa3b044d15bb780648c774b906      -> binding KV

# === PADDLE Billing (provider) ===
# Default is only used when a project cannot be resolved. Project environment
# selects the actual provider: test -> sandbox, live -> production.
PADDLE_DEFAULT_ENVIRONMENT=test

# --- SECRETS (local: .dev.vars | prod: wrangler secret put <NAME> --config billing.slyxup.com/wrangler.jsonc) ---

# Paddle API key — Paddle Sandbox/Prod Dashboard > Developer tools > Authentication > API keys
# https://sandbox-vendors.paddle.com/authentication (sandbox) / https://vendors.paddle.com/authentication (prod)
PADDLE_API_KEY=pdl_sdbx_apikey_REPLACE_ME
PADDLE_SANDBOX_API_KEY=pdl_sdbx_apikey_REPLACE_ME
PADDLE_PRODUCTION_API_KEY=pdl_live_apikey_REPLACE_ME

# Paddle webhook secret — Dashboard > Developer tools > Notifications > destination signing secret
# Used to verify `Paddle-Signature: ts=...;h1=...` HMAC-SHA256 on POST /v1/webhooks/paddle
PADDLE_WEBHOOK_SECRET=pdl_ntfset_REPLACE_ME
PADDLE_SANDBOX_WEBHOOK_SECRET=pdl_ntfset_REPLACE_ME
PADDLE_PRODUCTION_WEBHOOK_SECRET=pdl_ntfset_REPLACE_ME

# Paddle.js client-side tokens are public-scoped tokens, but still configure
# them through Worker secrets so the billing config endpoint selects by mode.
PADDLE_SANDBOX_CLIENT_TOKEN=test_REPLACE_ME
PADDLE_PRODUCTION_CLIENT_TOKEN=live_REPLACE_ME

# Admin bearer secret for plan management endpoints (/v1/admin/plans CRUD via CLI/curl)
# Generate: openssl rand -hex 32
BILLING_ADMIN_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Configure this same endpoint in both Paddle dashboards, with each dashboard's
# own signing secret:
#   https://billing-slyxup-com.billing-86c.workers.dev/v1/webhooks/paddle
# Events: subscription.created, subscription.updated, subscription.canceled,
#         transaction.completed, adjustment.updated
